# Copy to .env.production and change every secret before deploying.
#   cp .env.production.example .env.production

# Public host of this Canvas instance (VPS IP or domain)
CANVAS_HOST=185.252.233.171
CANVAS_HTTP_PORT=80

# PostgreSQL (used by web, jobs, and DB container)
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# Canvas encryption (min 20 chars). Changing this invalidates encrypted data.
ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_hex_20

# Optional DB overrides (defaults match docker-compose.production.yml)
CANVAS_DATABASE_HOST=postgres
CANVAS_DATABASE_USERNAME=postgres
CANVAS_DATABASE_PRODUCTION=canvas_production

# Non-interactive db:initial_setup
CANVAS_LMS_ADMIN_EMAIL=admin@example.com
CANVAS_LMS_ADMIN_PASSWORD=CHANGE_ME_admin_password
CANVAS_LMS_ACCOUNT_NAME=Canvas LMS
CANVAS_LMS_STATS_COLLECTION=opt_out
